# LastDollar environment. Every variable is optional and public (NEXT_PUBLIC_* ends up in the
# browser bundle). Never put a private key or secret in any NEXT_PUBLIC_ variable.

# Canonical site URL used in metadata and social previews.
NEXT_PUBLIC_SITE_URL=https://lastdollar.vercel.app

# Override the Arc RPC used by the browser. Its origin is added to the Content-Security-Policy.
# NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io

# Override the LastDollarSplitter address. Defaults to evidence/mainnet/splitter-deployment.json.
# NEXT_PUBLIC_SPLITTER_ADDRESS=0x...

# Automated browser tests only: "local-test" points the app at a local chain and shows a banner.
# NEXT_PUBLIC_NETWORK_MODE=

# --- Operational scripts (tools/), never used by the web app ---
# Primary and independent verification RPCs for deploy/proof/verify scripts.
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# ARC_VERIFY_RPC_URL=https://rpc.drpc.mainnet.arc.io
# Location of the locally generated proof wallets file (kept OUTSIDE the repository).
# LASTDOLLAR_WALLETS=~/.lastdollar/proof-wallets.env
# Maximum total network fees the mainnet proof run may spend, in USDC.
# LASTDOLLAR_FEE_CAP=0.05
